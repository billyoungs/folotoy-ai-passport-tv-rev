# Shared accepted media format and pacing; no addresses or credentials.
# Public pairing.code is permanent/reusable. pairing.token signs media tickets.
# Optional advertised endpoint (DNS/IPv4 only). Otherwise use HTTP Host + TV port.
# TV_PUBLIC_HOST=tv.example.com
# TV_PUBLIC_PORT=10745
TV_FPS=30
TV_ADAPTIVE=0
TV_RATE_START=1000000
TV_RATE_MIN=1000000
TV_RATE_MAX=1000000
TV_PACKET_TARGET=12288
TV_ENCODE=full
TV_TCP_PACING_RATE=1100000
TV_WRITE_PACING_RATE=1000000
TV_WRITE_PACING_CHUNK=12288
TV_MAX_SESSIONS=2
TV_MAX_PER_ADDRESS=2
TV_SHARED_LIVE=1
